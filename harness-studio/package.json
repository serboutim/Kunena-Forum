{
  "name": "harness-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based wire harness CAD: schematic, layout, connections and parts views, compatible with the .harness v1.3 JSON format.",
  "type": "module",
  "bin": {
    "harness": "cli/harness.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx cli/harness.ts"
  },
  "license": "MIT",
  "dependencies": {
    "immer": "^11.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
